# ─── Staging SSH Credentials ──────────────────────────────────────────────────
# Used by scripts/migrate-staging.sh to connect to the staging server.
# Copy this file to .env.staging.local and fill in your values.
# .env.staging.local is gitignored — never commit it.

# SSH connection
STAGING_SSH_HOST=your-server-ip-or-hostname
STAGING_SSH_USER=root
STAGING_SSH_KEY=~/.ssh/id_rsa

# Path to the app on the server
STAGING_APP_DIR=/var/www/honeycolm

# ─── Staging Database (optional) ──────────────────────────────────────────────
# Only needed if connecting to the staging DB directly from your local machine
# (e.g. via SSH tunnel). Normally migrations run on the server itself via SSH,
# so these are not required for scripts/migrate-staging.sh.
#
# STAGING_DB_HOST=127.0.0.1
# STAGING_DB_PORT=3306
# STAGING_DB_DATABASE=honeycolm
# STAGING_DB_USERNAME=honeycolm_user
# STAGING_DB_PASSWORD=
