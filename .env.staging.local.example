# Staging SSH credentials — used by scripts/migrate-staging.sh
# Copy this file to .env.staging.local and fill in your values.
# .env.staging.local is gitignored — never commit it.

STAGING_SSH_HOST=your-server-ip-or-hostname
STAGING_SSH_USER=root
STAGING_SSH_KEY=~/.ssh/id_rsa
STAGING_APP_DIR=/var/www/html
