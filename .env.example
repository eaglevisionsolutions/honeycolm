# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Honeycolm"
APP_ENV=staging                    # local | staging | production
APP_URL=https://dev.honeycolm.ca
APP_DEBUG=false                    # never true in production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=honeycolm
DB_USERNAME=honeycolm_user
DB_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=3600                    # access token lifetime in seconds (1 hour)
JWT_REFRESH_EXPIRY=604800          # refresh token lifetime in seconds (7 days)

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=https://dev.honeycolm.ca,https://honeycolm.ca

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx
# URLs Stripe redirects to after checkout
STRIPE_SUCCESS_URL=https://honeycolm.ca/ca/wallet?topup=success
STRIPE_CANCEL_URL=https://honeycolm.ca/ca/wallet?topup=cancelled

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_DRIVER=smtp                  # smtp | mail | log (log = write to file, no send)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls                # tls | ssl | none
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@honeycolm.ca
EMAIL_FROM_NAME=Honeycolm

# ─── Random.org ───────────────────────────────────────────────────────────────
# Used for verifiable draw randomness. Get a key at: https://api.random.org/dashboard
RANDOM_ORG_API_KEY=

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880            # max file size in bytes (default: 5 MB)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ─── Platform (overrides DB settings if set) ──────────────────────────────────
# These are normally managed via the Admin → Settings page (stored in DB).
# Only set here if you need to force a value regardless of DB config.
# MARGIN_WARNING_THRESHOLD=20      # % — warn admin when swarm margin drops below this
# FILLING_FAST_THRESHOLD=80        # % — show "filling fast" badge above this fill %
# MIN_WITHDRAWAL_AMOUNT=10         # minimum Nectar withdrawal amount
