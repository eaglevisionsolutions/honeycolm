# Application
APP_NAME="My PWA App"
APP_ENV=local
APP_URL=http://localhost
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pwa_app
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# CORS
CORS_ORIGINS=http://localhost,http://localhost:8080

# Docker (local dev only — docker compose)
DB_EXPOSE_PORT=3307
DB_ROOT_PASSWORD=rootsecret
APP_PORT=8080
PMA_PORT=8081

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://honeycolm.ca/ca/wallet?topup=success
STRIPE_CANCEL_URL=https://honeycolm.ca/ca/wallet?topup=cancelled
# STRIPE_CONNECT_CLIENT_ID=ca_xxx
# STRIPE_CONNECT_ENABLED=false
# PLATFORM_FEE_BASIS_POINTS=250
# PLATFORM_FEE_LABEL=Service Fee
