{
    "name": "eaglevision/pwa-app",
    "description": "Eagle Vision Solutions PWA Application",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "firebase/php-jwt": "^6.10",
        "stripe/stripe-php": "^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Exceptions/Exceptions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "analyse": "phpstan analyse app --level=8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
